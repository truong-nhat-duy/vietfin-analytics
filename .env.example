# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---
VIETFIN_DUCKDB_PATH=data/vietfin.duckdb
VIETFIN_POSTGRES_DSN=postgresql://vietfin:changeme@localhost:5432/vietfin

# --- Object storage for raw documents (Sprint 3+) ---
VIETFIN_OBJECT_STORAGE_BUCKET=
VIETFIN_OBJECT_STORAGE_ENDPOINT=

# --- Optional data provider credentials (only if you have a licensed feed) ---
VIETFIN_SSI_API_KEY=
VIETFIN_SSI_API_SECRET=

# --- App ---
VIETFIN_ENV=development
VIETFIN_LOG_LEVEL=INFO
